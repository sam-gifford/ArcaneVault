@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4">Your collection, organised.</h1>
    <p class="lead">Track collectible items, quantities, and categories in one secure vault.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/CollectionItems/Index" class="btn btn-primary btn-lg">Open My Collection</a>
    }
    else
    {
        <a asp-page="/Auth/Register" class="btn btn-primary btn-lg me-2">Create Account</a>
        <a asp-page="/Auth/Login" class="btn btn-outline-secondary btn-lg">Login</a>
    }
</div>
