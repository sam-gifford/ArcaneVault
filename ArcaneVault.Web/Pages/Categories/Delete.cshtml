@* Name: [Your Name] | Admin No: [Your Admin No] | Tutorial Group: [Your Group] *@

@page "{categoryCode}"
@model ArcaneVault.Web.Pages.Categories.DeleteModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>Delete Category</h1>
            <hr />

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Category != null)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Warning!</strong> This action cannot be undone.
                </div>

                <div class="card border-danger">
                    <div class="card-body">
                        <h5 class="card-title">@Model.Category.CategoryName</h5>
                        <p class="card-text">
                            Are you sure you want to delete the category <strong>@Model.Category.CategoryCode</strong>?
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Code:</label>
                            <p>@Model.Category.CategoryCode</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Name:</label>
                            <p>@Model.Category.CategoryName</p>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <form method="post" style="display:inline;">
                        <input type="hidden" asp-for="CategoryCode" />
                        <button type="submit" class="btn btn-danger">
                            Yes, Delete Category
                        </button>
                    </form>
                    <a href="@Url.Page("./Index")" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>
