@* Name: [Your Name] | Admin No: [Your Admin No] | Tutorial Group: [Your Group] *@

@page
@model ArcaneVault.Web.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>Categories</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="@Url.Page("./Create")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Category
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Categories.Count == 0)
    {
        <div class="alert alert-info">
            No categories found. <a href="@Url.Page("./Create")">Create one now</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Category Code</th>
                        <th>Category Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td>
                                <strong>@category.CategoryCode</strong>
                            </td>
                            <td>@category.CategoryName</td>
                            <td>
                                <a href="@Url.Page("./Details", new { categoryCode = category.CategoryCode })" class="btn btn-sm btn-info">
                                    View
                                </a>
                                <a href="@Url.Page("./Edit", new { categoryCode = category.CategoryCode })" class="btn btn-sm btn-warning">
                                    Edit
                                </a>
                                <a href="@Url.Page("./Delete", new { categoryCode = category.CategoryCode })" class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
