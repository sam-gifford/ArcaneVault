@* Name: [Your Name] | Admin No: [Your Admin No] | Tutorial Group: [Your Group] *@

@page
@model ArcaneVault.Web.Pages.Categories.CreateModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>Create New Category</h1>
            <hr />

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Category.CategoryCode" class="form-label">Category Code</label>
                    <input asp-for="Category.CategoryCode" class="form-control" placeholder="e.g., COINS" />
                    <span asp-validation-for="Category.CategoryCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category.CategoryName" class="form-label">Category Name</label>
                    <input asp-for="Category.CategoryName" class="form-control" placeholder="e.g., Coins & Currency" />
                    <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="@Url.Page("./Index")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
